# Anki Desktop Container for E2E Testing and Demo Screenshots
# Uses pre-built Anki wheels from PyPI for faster builds
#
# Build: podman build -t acli-anki-e2e -f e2e/Containerfile .
# Run:   podman run --rm -it -v /tmp/.X11-unix:/tmp/.X11-unix -e DISPLAY=$DISPLAY acli-anki-e2e

ARG DEBIAN_FRONTEND="noninteractive"

FROM python:3.11-slim

# Install runtime dependencies for Qt GUI, screenshots, and automation
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
    # For downloading Bun
    curl \
    unzip \
    ca-certificates \
    # Audio
    libasound2 \
    # DBus for Qt
    libdbus-1-3 \
    dbus \
    # Fonts
    libfontconfig1 \
    libfreetype6 \
    fonts-dejavu-core \
    # OpenGL
    libgl1 \
    libegl1 \
    # GLib
    libglib2.0-0 \
    # NSS (for web content)
    libnss3 \
    # X11/XCB libraries for Qt
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xkb1 \
    libxcb-cursor0 \
    libxcb1 \
    libx11-6 \
    libx11-xcb1 \
    # X11 extensions
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxi6 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxrandr2 \
    libxrender1 \
    libxtst6 \
    libxfixes3 \
    # Virtual framebuffer for headless testing
    xvfb \
    # For debugging
    x11-utils \
    # Screenshot tools
    scrot \
    imagemagick \
    # Window management for automation
    xdotool \
    wmctrl \
    # Lightweight window manager for headless automation
    openbox \
    # Process management
    procps \
    # mpv for Anki audio (required even if unused)
    mpv \
    && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

# Create virtual environment and install Anki
WORKDIR /opt/anki
RUN python -m venv venv \
    && ./venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Anki from PyPI with PyQt6 for GUI
RUN ./venv/bin/pip install --no-cache-dir aqt==24.11 PyQt6 PyQt6-WebEngine

ENV PATH=/opt/anki/venv/bin:$PATH

# Create non-root user and install Bun for them
RUN useradd --create-home --shell /bin/bash anki \
    && cp -r /root/.bun /home/anki/.bun \
    && chown -R anki:anki /home/anki/.bun

USER anki
WORKDIR /home/anki

# Add Bun to anki user's PATH
ENV PATH="/home/anki/.bun/bin:$PATH"

# Create Anki data directories and output directories
RUN mkdir -p /home/anki/.local/share/Anki2 \
    && mkdir -p /home/anki/collections \
    && mkdir -p /home/anki/output/screenshots \
    && mkdir -p /home/anki/demo-content

# Environment for Qt and automation
ENV QT_QPA_PLATFORM=xcb
ENV XDG_RUNTIME_DIR=/tmp/runtime-anki

# Copy entry script
COPY --chown=anki:anki e2e/entrypoint.sh /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["anki"]
